# NutriScale OS — copy this to .env (.env is never committed to git)
# LLM (optional) — with a key, agents write copy/strategy with an LLM
GOS_LLM_API_KEY=
GOS_LLM_MODEL=
GOS_LLM_BASE_URL=https://api.openai.com/v1
# Backend port
PORT=8765
# First-run Owner login (only creates the user the first time; change the password later with scripts/set_password.py)
NUTRISCALE_OWNER_USER=malik
NUTRISCALE_OWNER_PASSWORD=
