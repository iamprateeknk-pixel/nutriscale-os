# NutriScale OS — env ki nakal karke .env banao (.env git par kabhi nahi jayegi)
# LLM (optional) — key ho to agents ka copy/strategy LLM se banega
GOS_LLM_API_KEY=
GOS_LLM_MODEL=
GOS_LLM_BASE_URL=https://api.openai.com/v1
# Backend port
PORT=8765
# Pehli baar ka Owner login (sirf pehli baar user banata hai; baad me password scripts/set_password.py se badlo)
NUTRISCALE_OWNER_USER=malik
NUTRISCALE_OWNER_PASSWORD=
